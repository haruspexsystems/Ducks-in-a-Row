<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <!-- Direct reference exists only to lift the transitive native SQLite above
         the advisory floor; see the comment in Directory.Packages.props. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
    <PackageReference Include="BouncyCastle.Cryptography" />
    <PackageReference Include="DnsClient" />
    <PackageReference Include="System.Formats.Cbor" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.Abstractions" />
    <PackageReference Include="MailKit" />
    <!-- Direct reference exists only to lift MimeKit's transitive Pkcs above the
         advisory floor (issue #556); see the comment in Directory.Packages.props. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Serilog.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <!-- The module contract (licence design section 5). Referenced here so it ships in
         both hosts' output, where the module host shares it with a paid module from the
         default load context. -->
    <ProjectReference Include="..\Certus.Modules.Abstractions\Certus.Modules.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Certus.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The pinned Apple attestation root. AppleAttestationVerifier checks its
         SHA-256 against AppleAttestationOids.RootSha256Fingerprint at load and
         refuses to construct on mismatch. -->
    <EmbeddedResource Include="Acme\Attestation\AppleEnterpriseAttestationRootCa.pem"
                      LogicalName="Certus.Core.Acme.Attestation.AppleEnterpriseAttestationRootCa.pem" />
  </ItemGroup>

</Project>
