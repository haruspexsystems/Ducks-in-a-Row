<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- When this project is referenced by Certus.Service, exclude appsettings
       to avoid NETSDK1152 duplicate publish output conflicts -->
  <ItemGroup>
    <Content Update="appsettings.json" CopyToPublishDirectory="Never" />
    <Content Update="appsettings.*.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Negotiate" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Certus.Core\Certus.Core.csproj" />
    <!-- Note: Certus.Adcs is NOT referenced here because it targets net8.0-windows.
         The concrete AdcsClient is registered in DI by Certus.Service (the production host).
         Certus.Web programs against IAdcsClient from Certus.Core only. -->
  </ItemGroup>

</Project>
