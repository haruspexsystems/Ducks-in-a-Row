{
  "Certus": {
    "CaConnectionString": null,
    "DatabasePath": null,
    "ExternalUrl": null,
    "SyncIntervalMinutes": 5,
    "RequestHistoryDays": 30,
    "EnableWalMode": true
  },
  "Certus:Alerts": {
    "Enabled": true,
    "CheckIntervalMinutes": 60,
    "ThresholdDays": [30, 14, 7, 1],
    "Smtp": null,
    "Webhook": null
  },
  "Auth": {
    "Mode": "Negotiate",
    "AdminGroup": null,
    "RequireHttps": true,
    "TrustedProxies": []
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:5000"
      },
      "Https": {
        "Url": "https://0.0.0.0:5001",
        "Certificate": {
          "Path": "",
          "Password": ""
        }
      }
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
