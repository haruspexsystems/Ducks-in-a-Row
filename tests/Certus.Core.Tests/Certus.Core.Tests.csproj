<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Target net10.0-windows to allow testing Certus.Adcs (COM interop) -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Certus.Core\Certus.Core.csproj" />
    <ProjectReference Include="..\..\src\Certus.Adcs\Certus.Adcs.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Stand in module assemblies with chosen references, shared with Certus.Service.Tests (issue #538). -->
    <Compile Include="..\Shared\ModuleAssemblyBuilder.cs" Link="Shared\ModuleAssemblyBuilder.cs" />
    <Compile Include="..\Shared\AuthenticodeTestSigner.cs" Link="Shared\AuthenticodeTestSigner.cs" />
    <!-- The real time backstop for a wait a regression would leave pending (issues #289 and #381). -->
    <Compile Include="..\Shared\PoolAwareWait.cs" Link="Shared\PoolAwareWait.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="FluentAssertions" />
    <Using Include="NSubstitute" />
  </ItemGroup>

</Project>
