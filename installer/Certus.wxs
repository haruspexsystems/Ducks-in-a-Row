<?xml version="1.0" encoding="UTF-8"?>

<!--
  Ducks in a Row: WiX v4 MSI Installer

  Installs the Ducks in a Row Windows Service:
    Copies publish output to Program Files\Ducks in a Row
    Creates the data directory (default ProgramData\Ducks in a Row) for
    database, logs, and runtime configuration; the administrator can choose
    another location and the choice is recorded in the registry
    Registers the DucksInARow Windows Service (auto start), with service
    recovery: restart after the first and second failures (issue #495)
    Creates an empty, protected modules folder in the install folder and
    records the module contract the core carries, for the paid module's
    installer (issue #495)

  Build (normally via build.ps1, which supplies ProductVersion from
  Directory.Build.props and the module contract from the contract
  assembly's own project):
    dotnet publish src/Certus.Service -c Release -r win-x64
    wix build installer/Certus.wxs -d ProductVersion=1.0.0.0 -d ModuleContractVersion=1.0 -d ModuleContractMajor=1 -o artifacts/Ducks-in-a-Row.msi -bindpath artifacts/publish
-->

<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:fire="http://wixtoolset.org/schemas/v4/wxs/firewall"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <!-- Fallback for direct wix invocations; build.ps1 always defines it. -->
  <?ifndef ProductVersion ?>
  <?define ProductVersion = "1.0.0.0" ?>
  <?endif ?>

  <!--
    The module contract the core carries (licence design section 14.2, issue
    #495). build.ps1 always defines both from the AssemblyVersion of
    src/Certus.Modules.Abstractions, the assembly ModuleHost reads its own
    contract from, and checks the published DLL agrees. These fallbacks serve
    only a direct wix invocation, and ModuleContractTests fails when they
    drift from that assembly. Always major.minor: the upgrade check below
    compares by prefix, and the paid module's installer reads the major.
  -->
  <?ifndef ModuleContractVersion ?>
  <?define ModuleContractVersion = "1.0" ?>
  <?endif ?>
  <?ifndef ModuleContractMajor ?>
  <?define ModuleContractMajor = "1" ?>
  <?endif ?>

  <Package
    Name="Ducks in a Row"
    Manufacturer="Haruspex Systems B.V."
    Version="$(var.ProductVersion)"
    UpgradeCode="8A3D7F2E-5B1C-4E9A-B6D8-2F4A7C1E3B5D"
    Scope="perMachine">

    <SummaryInformation
      Description="Ducks in a Row ACME-to-ADCS Certificate Proxy"
      Manufacturer="Haruspex Systems B.V." />

    <!--
      AllowSameVersionUpgrades: development and QA rebuild the same version
      number; without it a rebuild installs beside the previous product
      (duplicate ARP rows) and the shared components then break uninstall
      (refcounts never reach zero, so the service is neither stopped nor
      removed). With it, one install of this MSI also removes ALL related
      products sharing the UpgradeCode — including the historical duplicates.
    -->
    <MajorUpgrade
      AllowSameVersionUpgrades="yes"
      DowngradeErrorMessage="A newer version of Ducks in a Row is already installed."
      Schedule="afterInstallInitialize" />

    <MediaTemplate EmbedCab="yes" />

    <!--
      Install wizard. The dialog sequence itself (Welcome, destination, data
      folder, service options, progress, completion) lives in CertusUi.wxs.
      WIXUI_INSTALLDIR / WIXUI_DATADIR tell the destination style dialogs which
      directory property to edit (hand authored dialog set, so we set them
      directly instead of via a built-in dialog set attribute).
    -->
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <Property Id="WIXUI_DATADIR" Value="DATAFOLDER" />
    <UIRef Id="CertusInstallUI" />

    <!--
      START_SERVICE controls whether the service is started immediately after the
      files are copied. Default on. It is a public, secure property so an
      unattended install can override it, e.g.
        msiexec /i Ducks-in-a-Row.msi /qn START_SERVICE=0
      The service is always registered (auto start on boot) regardless; this only
      governs starting it now. The service-options dialog binds its checkbox here.
    -->
    <Property Id="START_SERVICE" Value="1" Secure="yes" />

    <!--
      Monitor mode (issue #471): the service watches the CA and never issues or
      revokes. MONITOR_ONLY=1 chooses it, from the service options dialog or
      unattended:
        msiexec /i Ducks-in-a-Row.msi /qn MONITOR_ONLY=1
      The service reads the choice once at startup from the REG_SZ value Mode
      beside DataDirectory (CertusInstanceMode, issue #470), which only a local
      administrator can change.

      Four rules, each one a way this has gone wrong elsewhere:

      1. MONITOR_ONLY has no default and no RegistrySearch of its own. A
         checkbox shows ticked for ANY value, so a remembered "full" read into
         it would tick the box, and a remembered value would also outrank the
         command line (AppSearch ordering, as DATAFOLDER notes above).
      2. The remembered value is read into REMEMBERED_MODE instead, and turned
         into MONITOR_ONLY=1 only when it says monitor (~= ignores case, as the
         service does). The action runs once, in whichever sequence runs first,
         so it pre-ticks the box on an upgrade but never re-ticks one the user
         cleared, and a silent upgrade or a repair still keeps monitor mode.
      3. The value written is always the string "monitor" or "full", never
         absent and never a number. The service refuses a REG_DWORD, or any
         other word, at startup (the misleading MSI Error 1920 territory).
      4. A remembered value the service would refuse stops setup rather than
         being overwritten with full: a server someone tried to put in monitor
         mode must never become an issuing server silently. RegistrySearch
         Type="raw" returns a REG_DWORD as "#1". Neither condition applies to an
         uninstall (REMOVE=ALL, which msiexec /x, the bundle's uninstall and a
         major upgrade's removal of the old product all set), so a bad value
         never traps anyone with a product they cannot remove.
    -->
    <Property Id="MONITOR_ONLY" Secure="yes" />
    <Property Id="REMEMBERED_MODE" Secure="yes">
      <RegistrySearch Id="RememberedMode"
                      Root="HKLM"
                      Key="Software\Haruspex Systems\Ducks in a Row"
                      Name="Mode"
                      Type="raw" />
    </Property>
    <SetProperty Id="MONITOR_ONLY" Value="1" After="AppSearch" Sequence="first"
                 Condition='NOT MONITOR_ONLY AND REMEMBERED_MODE ~= "monitor"' />
    <!-- Private, so the command line cannot set it; the value PersistMode writes. -->
    <Property Id="CertusModeValue" Value="full" />
    <SetProperty Id="CertusModeValue" Value="monitor" Before="InstallInitialize" Sequence="execute"
                 Condition='MONITOR_ONLY = "1"' />
    <Launch Condition='REMOVE ~= "ALL" OR NOT REMEMBERED_MODE OR REMEMBERED_MODE ~= "monitor" OR REMEMBERED_MODE ~= "full"'
            Message="The registry value Mode under HKLM\SOFTWARE\Haruspex Systems\Ducks in a Row is [REMEMBERED_MODE], which Ducks in a Row cannot use. Set it to monitor or full as a string value (REG_SZ), or delete it for full mode, then run setup again. A value that starts with # is a number (REG_DWORD), which the service does not read." />
    <Launch Condition='REMOVE ~= "ALL" OR NOT MONITOR_ONLY OR MONITOR_ONLY = "1"'
            Message="MONITOR_ONLY takes the value 1 for monitor mode. Leave it out for full mode; on an upgrade, leaving it out keeps the mode this server already has." />

    <!--
      The upgrade warning (licence design sections 14.2 and 14.3, issue #495).
      An upgrade that moves the module contract to another major leaves an
      installed paid module unable to load, so paid features go off. That must
      never happen silently: the wizard warns first (ModuleContractDlg in
      CertusUi.wxs), and an unattended upgrade stops unless
      ALLOW_INCOMPATIBLE_MODULE=1 says to go ahead. Issuance never notices
      either way.

      What makes this work without a custom action:

      1. INSTALLED_MODULE_CONTRACT reads the contract the installed core
         recorded. AppSearch runs before RemoveExistingProducts (the
         MajorUpgrade above is scheduled afterInstallInitialize), so it still
         sees the old core's value, not the one this package writes.
      2. INSTALLED_MODULE_MANIFEST finds any module.json one level under the
         installed core's modules folder, whatever the module's id: the paid
         module's installer puts its files in modules\<id>\, module.json
         included (design section 14.1).
      3. Every module installed by its own MSI was built for the installed
         core's major, because that MSI's LaunchCondition requires it. So a
         recorded contract with another major, and a module present, means the
         module will not load after this upgrade. The trailing dot keeps a
         contract 10.x apart from 1.x. An absent value (a fresh install, or a
         core from before this value existed) never warns, and NOT Installed
         keeps a repair from warning even over a planted value.
      4. ModuleContractCrossed is private and computed in both sequences, so
         the command line cannot set it. The override is the only public
         switch, and it is never remembered: no default, no RegistrySearch.
      5. The refusal passes at full UI (UILevel 5), where the page asks
         instead, and the page's Continue sets the Secure override, so the
         execute sequence passes whatever UILevel it sees. Setup.exe /passive
         is reduced UI, so it is refused like a silent install. Like every
         Launch here, both spare an uninstall.
    -->
    <Property Id="INSTALLED_MODULE_CONTRACT" Secure="yes">
      <RegistrySearch Id="InstalledModuleContract"
                      Root="HKLM"
                      Key="Software\Haruspex Systems\Ducks in a Row"
                      Name="ModuleContractVersion"
                      Type="raw" />
    </Property>
    <Property Id="INSTALLED_MODULE_MANIFEST" Secure="yes">
      <RegistrySearch Id="InstalledModulesRoot"
                      Root="HKLM"
                      Key="Software\Haruspex Systems\Ducks in a Row"
                      Name="InstallDir"
                      Type="directory">
        <DirectorySearch Id="InstalledModuleManifest" Path="modules" Depth="1">
          <FileSearch Name="module.json" />
        </DirectorySearch>
      </RegistrySearch>
    </Property>
    <!-- Private: the contract this package carries, for the page and message text. -->
    <Property Id="CertusModuleContract" Value="$(var.ModuleContractVersion)" />
    <SetProperty Id="ModuleContractCrossed" Value="1" After="AppSearch" Sequence="both"
                 Condition='NOT Installed AND INSTALLED_MODULE_CONTRACT AND NOT (INSTALLED_MODULE_CONTRACT &lt;&lt; "$(var.ModuleContractMajor).") AND INSTALLED_MODULE_MANIFEST' />
    <Property Id="ALLOW_INCOMPATIBLE_MODULE" Secure="yes" />
    <Launch Condition='REMOVE ~= "ALL" OR NOT ModuleContractCrossed OR ALLOW_INCOMPATIBLE_MODULE = "1" OR UILevel = 5'
            Message="The paid module installed on this server ([INSTALLED_MODULE_MANIFEST]) was built for module contract [INSTALLED_MODULE_CONTRACT], and this release carries contract [CertusModuleContract]. After this upgrade the paid module would not load, and paid features would stay off until you install the paid module built for this release. Certificate issuance and renewal are not affected. To upgrade anyway, run setup again with ALLOW_INCOMPATIBLE_MODULE=1." />
    <Launch Condition='REMOVE ~= "ALL" OR NOT ALLOW_INCOMPATIBLE_MODULE OR ALLOW_INCOMPATIBLE_MODULE = "1"'
            Message="ALLOW_INCOMPATIBLE_MODULE takes the value 1. Leave it out unless an upgrade must go ahead although the paid module installed on this server will not load afterwards." />

    <!--
      Remember the directory the user chose. Without this, a major upgrade would
      reinstall to the default location and orphan the previous files. The
      RegistrySearch pre-fills INSTALLFOLDER on upgrade; the PersistInstallDir
      component below writes the value during install. The search deliberately
      reads only the new registry hive: rebrand installs must not inherit the
      old Program Files\Certus location.
    -->
    <Property Id="INSTALLFOLDER" Secure="yes">
      <RegistrySearch Id="RememberedInstallDir"
                      Root="HKLM"
                      Key="Software\Haruspex Systems\Ducks in a Row"
                      Name="InstallDir"
                      Type="raw" />
    </Property>

    <!--
      The data directory (database, logs, runtime configuration, HTTPS
      certificate). Chosen on the DataDirDlg screen or unattended:
        msiexec /i Ducks-in-a-Row.msi /qn DATAFOLDER=D:\DucksData
      The service resolves it through the DataDirectory registry value written
      by PersistDataDir below. Remembered across upgrades like INSTALLFOLDER;
      moving the data directory on upgrade is not supported (the remembered
      value wins over the command line then — AppSearch ordering).
    -->
    <Property Id="DATAFOLDER" Secure="yes">
      <RegistrySearch Id="RememberedDataDir"
                      Root="HKLM"
                      Key="Software\Haruspex Systems\Ducks in a Row"
                      Name="DataDirectory"
                      Type="raw" />
    </Property>

    <!--
      Branding assets (issue #339), generated by
      scripts/branding/New-InstallerBranding.py from the product's own mascot.
      Never hand edited; see installer/branding/README.md for the sizes and for
      why the artwork keeps to the left of the wizard's text.

      The names are bare because build.ps1 passes -bindpath installer/branding,
      so a bare name resolves whether WiX searches the bindpath or the source
      file's own directory. A "branding/" prefix would resolve through that
      bindpath as branding/branding/.

      WixUIBannerBmp reaches the two hand authored dialogs in CertusUi.wxs as
      well as the stock ones, because both bind the WixUI_Bmp_Banner symbol.

      ARPPRODUCTICON covers the bare MSI only: installed through the setup
      bundle the MSI carries ARPSYSTEMCOMPONENT=1 and shows no Apps and
      Features row of its own, so the icon a user normally sees is the one
      Bundle.wxs sets with IconSourceFile.
    -->
    <WixVariable Id="WixUIBannerBmp" Value="banner.bmp" />
    <WixVariable Id="WixUIDialogBmp" Value="dialog.bmp" />
    <Icon Id="DucksIcon" SourceFile="ducks.ico" />
    <Property Id="ARPPRODUCTICON" Value="DucksIcon" />

    <!-- Installation directory: Program Files\Ducks in a Row. The modules
         folder's Id is mixed case on purpose: an upper case Id is a public
         property, and MODULESFOLDER= on the command line could then move it
         away from where the module host looks (AppContext.BaseDirectory). -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Ducks in a Row">
        <Directory Id="ModulesFolder" Name="modules" />
      </Directory>
    </StandardDirectory>

    <!-- Start Menu program group for the web UI shortcut -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="CertusStartMenuDir" Name="Ducks in a Row" />
    </StandardDirectory>

    <!-- Data directory: ProgramData\Ducks in a Row unless the user chose another -->
    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="DATAFOLDER" Name="Ducks in a Row">
        <Directory Id="LOGSFOLDER" Name="logs" />
      </Directory>
    </StandardDirectory>

    <!-- Features -->
    <Feature Id="MainFeature" Title="Ducks in a Row Service" Level="1">
      <ComponentGroupRef Id="PublishFiles" />
      <ComponentRef Id="DataDirectory" />
      <ComponentRef Id="LogsDirectory" />
      <ComponentRef Id="InstallFolderPermissions" />
      <ComponentRef Id="ModulesDirectory" />
      <ComponentRef Id="ServiceComponent" />
      <ComponentRef Id="StartServiceControl" />
      <ComponentRef Id="PersistInstallDir" />
      <ComponentRef Id="PersistDataDir" />
      <ComponentRef Id="PersistMode" />
      <ComponentRef Id="PersistModuleContract" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>

    <!--
      Component GUIDs below are new with the rebrand: every keypath moved
      (directories, service, registry hive), and component rules say a GUID
      follows its keypath. Sharing the old GUIDs with the legacy products
      would resurrect the refcount problems this release fixes.
    -->

    <!-- Create data directory. No RemoveFolder on purpose: the database and
         configuration survive uninstall.

         Protected, owned by Administrators, and writable only by SYSTEM and
         Administrators (issue #489). It used to inherit %ProgramData%'s DACL,
         which lets every local user create files in it and own what they
         create, and a standard user took over the service's own configuration
         files that way. The SDDL goes into the MsiLockPermissionsEx table, so it
         is applied on every install and upgrade, to a folder that already
         exists as much as to a new one; the MajorUpgrade above removes the old
         product first, so CreateFolders runs afresh. Subfolders, logs among
         them, inherit it. The service creates any folder it needs with the same
         DACL (ProtectedFolder.cs), so the result does not depend on which of
         the two makes it first. -->
    <Component Id="DataDirectory" Directory="DATAFOLDER" Guid="00BB1215-0A03-48CC-BE07-3281CB24CEF3">
      <CreateFolder>
        <PermissionEx Sddl="O:BAD:PAI(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)" />
      </CreateFolder>
    </Component>

    <!-- Create logs directory. It inherits the data directory's DACL. -->
    <Component Id="LogsDirectory" Directory="LOGSFOLDER" Guid="FB45691B-01D9-4ADB-9F5F-454FF93138B8">
      <CreateFolder />
    </Component>

    <!-- The installation folder, protected the same way with read and execute
         for Users (issue #489). Under Program Files that changes nothing a user
         could do, but the wizard lets an administrator install anywhere, and
         under a root a standard user can write, such as a folder directly
         under C:\, they could otherwise drop a file beside the executable the
         service runs as LocalSystem. A component of its own, so the service
         component keeps its contents. -->
    <Component Id="InstallFolderPermissions" Directory="INSTALLFOLDER" Guid="8E3984FD-4149-485E-8D3F-78D5FF59503C">
      <CreateFolder>
        <PermissionEx Sddl="O:BAD:PAI(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)(A;OICI;0x1200a9;;;BU)" />
      </CreateFolder>
    </Component>

    <!-- The modules folder the paid module installs into (licence design
         section 14.2, issue #495). Empty on a free install; the module host
         reads an empty folder as no module, exactly as an absent one.

         It carries the install folder's SDDL as an explicit, protected DACL
         rather than inheriting it. The MsiLockPermissionsEx row re-applies
         the DACL and the owner to the folder itself on every install and
         upgrade, but MSI does not re-propagate a parent's DACL to a child
         that already exists (measured on lab 2019 for issue #489). So a
         modules folder that was already there, or one a standard user created
         before an install under a root they could write, still ends up owned
         by Administrators and writable only by SYSTEM and Administrators,
         which is what the module host's folder trust gate requires of every
         link from the install folder down. The paid module's installer must
         author nothing on this folder itself, only on modules\<id>\ below it:
         MSI removes it at uninstall only when it is empty. -->
    <Component Id="ModulesDirectory" Directory="ModulesFolder" Guid="441CCA99-C37E-4DC8-BD26-F106EA669599">
      <CreateFolder>
        <PermissionEx Sddl="O:BAD:PAI(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)(A;OICI;0x1200a9;;;BU)" />
      </CreateFolder>
    </Component>

    <!-- Windows Service registration (ServiceExe listed separately from harvested files) -->
    <Component Id="ServiceComponent" Directory="INSTALLFOLDER" Guid="765B4E7C-8AC3-4E41-B811-0326C86D7B21">
      <File Id="ServiceExe" Source="DucksInARow.Service.exe" KeyPath="yes" />
      <ServiceInstall
        Id="DucksService"
        Name="DucksInARow"
        DisplayName="Ducks in a Row Certificate Proxy"
        Description="Ducks in a Row ACME-to-ADCS certificate proxy. Provides RFC 8555 ACME protocol access to Active Directory Certificate Services."
        Type="ownProcess"
        Start="auto"
        ErrorControl="normal"
        Account="LocalSystem">
        <!--
          Service recovery (issue #495, licence design section 14.2). This
          reverses the decision PR #353 recorded, that the installer sets no
          recovery, for one reason: a paid module runs inside this process, and
          a defect in it (a stack overflow, a fail fast, a native fault) ends
          the process without the service reporting that it stopped. The module
          host's journal strikes a death before its ten minute healthy mark and
          sets that module version aside at two strikes, so exactly two
          restarts bring the service back without the module, and certificates
          keep flowing (the binding promise that the licence never stops them).

          The third action is none, which caps the flapping #353 worried about
          at two restarts. The failure actions flag stays off, and this custom
          action never sets it, so a stop that reports an error code (a fault
          found at startup, which a restart would only reach again) still
          stays down with its reason in the log.

          Never the core ServiceConfig or ServiceConfigFailureActions elements:
          they fill the MsiServiceConfig table family, which WiX warns (1149)
          the Windows Installer SDK documents as not working. And WiX does not
          validate these action words: anything but restart, reboot or
          runCommand quietly becomes none, so Test-BuildScripts.ps1 pins them.
        -->
        <util:ServiceConfig FirstFailureActionType="restart"
                            SecondFailureActionType="restart"
                            ThirdFailureActionType="none"
                            ResetPeriodInDays="1"
                            RestartServiceDelayInSeconds="30" />
      </ServiceInstall>
      <ServiceControl
        Id="StartDucksService"
        Name="DucksInARow"
        Stop="both"
        Remove="uninstall"
        Wait="yes" />
      <!--
        Legacy hygiene: machines that ran the duplicate stacked installs of the
        Certus era can be left with an orphaned CertusService whose product
        rows no longer stop it. Stopping and deleting a service that does not
        exist is a no op, so this is safe on clean machines. Remove="install"
        only — this product's own uninstall must not touch the legacy name.
      -->
      <ServiceControl
        Id="CleanupLegacyCertusService"
        Name="CertusService"
        Stop="both"
        Remove="install"
        Wait="yes" />
      <fire:FirewallException
        Id="CertusFirewall"
        Name="Ducks in a Row Certificate Proxy"
        Port="5000"
        Protocol="tcp"
        Profile="all"
        Scope="any"
        Description="Allow inbound TCP connections to the Ducks in a Row ACME proxy on port 5000" />
      <fire:FirewallException
        Id="CertusFirewallHttps"
        Name="Ducks in a Row Certificate Proxy (HTTPS)"
        Port="5001"
        Protocol="tcp"
        Profile="all"
        Scope="any"
        Description="Allow inbound TCP connections to the Ducks in a Row ACME proxy on HTTPS port 5001" />
    </Component>

    <!--
      Start the service now, only when START_SERVICE=1. Kept in its own component
      so the start is conditional while registration (in ServiceComponent above)
      stays unconditional. Stop/Remove are left to ServiceComponent so they always
      run on uninstall. Wait="no" so a slow start cannot hang or fail the install;
      the service serves the setup page even before the CA is configured.
    -->
    <Component Id="StartServiceControl" Directory="INSTALLFOLDER"
               Guid="C8AA9B19-AEF4-44B2-BA82-79F231B57FD8"
               Condition="START_SERVICE = 1">
      <RegistryValue Root="HKLM" Key="Software\Haruspex Systems\Ducks in a Row"
                     Name="StartServiceMarker" Type="integer" Value="1" KeyPath="yes" />
      <ServiceControl Id="StartDucksNow" Name="DucksInARow"
                      Start="install" Stop="none" Remove="none" Wait="no" />
    </Component>

    <!-- Persist the chosen install directory for in-place upgrades -->
    <Component Id="PersistInstallDir" Directory="INSTALLFOLDER"
               Guid="CDADDD70-6AC6-44FB-ADBA-D10BC68C1806">
      <RegistryValue Root="HKLM" Key="Software\Haruspex Systems\Ducks in a Row"
                     Name="InstallDir" Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
    </Component>

    <!--
      Persist the chosen data directory. This is where the service reads it
      from at runtime (CertusPaths resolves registry DataDirectory, then the
      ProgramData default), and where the RegistrySearch above remembers it on
      upgrade. Declarative registry write; no custom actions.
    -->
    <Component Id="PersistDataDir" Directory="DATAFOLDER"
               Guid="8FC68C99-D255-43D0-BC69-AE90642C722F">
      <RegistryValue Root="HKLM" Key="Software\Haruspex Systems\Ducks in a Row"
                     Name="DataDirectory" Type="string" Value="[DATAFOLDER]" KeyPath="yes" />
    </Component>

    <!--
      The instance mode the service reads at startup (issue #471; see the
      properties above). One unconditioned component writing a formatted value,
      rather than two components with opposite conditions: one owner of the
      value, nothing for a condition to re-evaluate on repair, and the value is
      always written. WriteRegistryValues runs before StartServices, so the
      first start reads it.
    -->
    <Component Id="PersistMode" Directory="INSTALLFOLDER"
               Guid="5E0B3C64-7D2A-4F19-9B8E-3A6C1D47F902">
      <RegistryValue Root="HKLM" Key="Software\Haruspex Systems\Ducks in a Row"
                     Name="Mode" Type="string" Value="[CertusModeValue]" KeyPath="yes" />
    </Component>

    <!--
      The module contract this core carries (issue #495), which the paid
      module's installer reads in its LaunchCondition and requires to have the
      same major. One unconditioned component, as PersistMode above: always
      written, always a string, always major.minor, and removed with the core.
      The next upgrade reads it back as INSTALLED_MODULE_CONTRACT before
      overwriting it.
    -->
    <Component Id="PersistModuleContract" Directory="INSTALLFOLDER"
               Guid="1C3B4E97-BCE9-431D-8BF4-8A45CF5C3D9B">
      <RegistryValue Root="HKLM" Key="Software\Haruspex Systems\Ducks in a Row"
                     Name="ModuleContractVersion" Type="string" Value="$(var.ModuleContractVersion)" KeyPath="yes" />
    </Component>

    <!--
      Start Menu shortcut to the web UI. This is the durable "it is installed"
      signal and the everyday entry point; the completion dialog is transient.
    -->
    <Component Id="StartMenuShortcut" Directory="CertusStartMenuDir"
               Guid="40A7F2A6-F1FF-44A4-9AA8-164365B3639A">
      <util:InternetShortcut Id="CertusWebUiShortcut"
                             Name="Ducks in a Row"
                             Target="http://localhost:5000/"
                             Type="url" />
      <RemoveFolder Id="RemoveCertusStartMenuDir" Directory="CertusStartMenuDir" On="uninstall" />
      <RegistryValue Root="HKLM" Key="Software\Haruspex Systems\Ducks in a Row"
                     Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
    </Component>

  </Package>

</Wix>
