<?xml version="1.0" encoding="UTF-8"?>

<!--
  Ducks in a Row: Burn bootstrapper bundle (issue #87)

  Chains the ASP.NET Core 10 Hosting Bundle (x64) ahead of the Ducks in a Row
  MSI so a clean server, online or offline, needs exactly one file. The
  Hosting Bundle payload is embedded (Compressed) and Permanent: this product
  never uninstalls the shared runtime, and Windows Update keeps servicing it.

  The bundle shows no wizard of its own on first install. The MSI package
  uses bal:DisplayInternalUICondition so the existing CertusUi.wxs wizard
  appears instead. The MSI is registered with ARPSYSTEMCOMPONENT=1 when it is
  installed through the bundle, so Apps and Features shows a single entry
  (the bundle). The bare MSI installed on its own keeps its normal entry.

  Build (normally via build.ps1, which supplies every define and downloads
  the pinned Hosting Bundle exe into installer/redist first):
    wix build installer/Bundle.wxs
      -d ProductVersion=1.0.0.0
      -d HostingBundleVersion=<HostingBundleVersion from build.ps1>
      -d HostingBundleMajor=10
      -d HostingBundleExe=installer/redist/dotnet-hosting-<that version>-win.exe
      -d MsiPath=artifacts/Ducks-in-a-Row.msi
      -o artifacts/Ducks-in-a-Row-Setup.exe
      -ext WixToolset.Bal.wixext -ext WixToolset.Netfx.wixext -arch x64
-->

<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal"
     xmlns:netfx="http://wixtoolset.org/schemas/v4/wxs/netfx">

  <!-- Fallback for direct wix invocations; build.ps1 always defines it. -->
  <?ifndef ProductVersion ?>
  <?define ProductVersion = "1.0.0.0" ?>
  <?endif ?>

  <!--
    UpgradeCode is the bundle's own upgrade identity and is deliberately NOT
    the MSI UpgradeCode (8A3D7F2E-5B1C-4E9A-B6D8-2F4A7C1E3B5D). Never change
    either one. A newer bundle version upgrades the older bundle; the MSI
    inside handles its own major upgrade through the MSI UpgradeCode.
  -->
  <!--
    IconSourceFile is the half of issue #339 the MSI cannot reach. The chained
    MSI below carries ARPSYSTEMCOMPONENT=1, so Apps and Features shows only the
    bundle's row and the MSI's own ARPPRODUCTICON is never seen by anyone who
    installs the normal way. This attribute is that row's icon, and it is also
    the icon Explorer, the download and the UAC prompt put on
    Ducks-in-a-Row-Setup.exe itself. Resolved through the -bindpath build.ps1
    passes, the same as the MSI's branding.
  -->
  <Bundle Name="Ducks in a Row"
          Manufacturer="Haruspex Systems B.V."
          Version="$(var.ProductVersion)"
          UpgradeCode="C50043FC-FFD1-4EE2-9417-A5F4E77C0864"
          IconSourceFile="ducks.ico"
          Compressed="yes">

    <!-- Burn writes a log per run; the prefix makes it findable in %TEMP%. -->
    <Log Prefix="DucksInARow-Setup" Extension="log" />

    <!-- Refuse 32 bit Windows up front instead of failing inside the x64 MSI. -->
    <bal:Condition Condition="VersionNT64"
                   Message="Ducks in a Row requires a 64-bit version of Windows." />

    <BootstrapperApplication>
      <!--
        hyperlinkLicense with an empty LicenseUrl shows no license link at
        all, matching the MSI wizard, which also omits the license screen.
        SuppressOptionsUI hides the bundle's own install folder option;
        folder choices belong to the MSI wizard (InstallDirDlg, DataDirDlg).
        LogoFile is the 64x64 image the hyperlinkLicense theme draws at 11,11;
        without it the frame carries the stock WiX logo. This frame is what a
        user sees while the runtime installs and on every repair, modify and
        uninstall, where the MSI runs quietly.
      -->
      <bal:WixStandardBootstrapperApplication
          Theme="hyperlinkLicense"
          LicenseUrl=""
          LogoFile="logo.png"
          SuppressOptionsUI="yes" />
    </BootstrapperApplication>

    <!--
      Sets AspNetCoreRuntimeVersion to the highest installed x64 ASP.NET Core
      runtime with the pinned major version, or leaves it undefined when none
      exists. This checks the runtime itself (Microsoft.AspNetCore.App), which
      is the right check for a Kestrel service; IIS and ANCM are not involved.
      The search keeps the highest version of the major it finds (WiX
      netcoresearch), so one older patch beside a current one does not count.
      HostingBundleMajor and HostingBundleVersion come from build.ps1, derived
      from the same pin as the payload, so the search, the detect floor below,
      and the embedded exe can never drift apart.
    -->
    <netfx:DotNetCoreSearch Id="AspNetCoreRuntimeSearch"
                            RuntimeType="aspnet"
                            Platform="x64"
                            MajorVersion="$(var.HostingBundleMajor)"
                            Variable="AspNetCoreRuntimeVersion" />

    <Chain>
      <!--
        The shared runtime. Permanent: uninstalling Ducks in a Row must never
        rip the runtime out from under other applications, and Windows Update
        services it from here on (so no UninstallArguments either).
        DetectCondition skips the install only when the installed runtime is
        at or above the pinned version itself, so an upgrade also brings an
        older 10.0.x up to the patch this release embeds (issue #760). Until
        then the floor was the major alone, and a server set up by an earlier
        release kept its old runtime. An undefined search variable makes the
        condition false, so a clean box installs. Measured on Server 2019 on
        2026-11-07 (1.1.0 on 10.0.10 upgraded by a 10.0.14 bundle): the newer
        Hosting Bundle uninstalls the older one, so 10.0.10 is gone afterwards,
        and it replaces ANCM without restarting IIS, but Restart Manager stops
        any w3wp that has ANCM loaded, which starts again on its next request.

        Exit codes 3010 (a restart is wanted) and 1641 (a restart was started)
        both count as plain success, so this package never tells Burn that a
        restart is due and the runtime update never makes the setup restart
        the server (decided 2026-11-07). WixStdBA takes its restart policy
        from the command line alone: under /quiet or /passive with no
        /norestart it restarts the
        server on its own as soon as any package reports one (balinfo.cpp
        106-109, WixStandardBootstrapperApplication.cpp 1318-1321 in v4.0.6),
        and no bundle setting changes that. Mapping the codes here is the one
        lever authoring has; the price is that a restart this runtime asks for
        is not reported: the setup exits 0 and the full UI shows no restart
        message, and only the Burn log line for this package names the code.
        1641 is mapped too because forceReboot stops the chain (apply.cpp 776),
        so the Ducks in a Row MSI would not install before a restart. We pass
        /norestart, so the runtime installer should never return 1641; if it
        did, it started that restart itself and nothing here could stop it.
        Leaving the ExitCode elements out is not the same: Burn treats an
        unmapped 3010 or 1641 as a restart (exeengine.cpp 975-993).
        Not covered: neither an MsiPackage nor the removal of the previous
        Ducks in a Row bundle (a related bundle Burn uninstalls on upgrade)
        takes an ExitCode, so if the MSI or that removal reports 3010 (a file
        stays in use) WixStdBA's policy applies again. That is why the docs
        keep /norestart on unattended runs.
      -->
      <ExePackage Id="AspNetCoreHostingBundle"
                  DisplayName="ASP.NET Core $(var.HostingBundleVersion) Hosting Bundle (x64)"
                  SourceFile="$(var.HostingBundleExe)"
                  Compressed="yes"
                  Permanent="yes"
                  Vital="yes"
                  DetectCondition="AspNetCoreRuntimeVersion &gt;= v$(var.HostingBundleVersion)"
                  InstallArguments="/install /quiet /norestart">
        <ExitCode Value="3010" Behavior="success" />
        <ExitCode Value="1641" Behavior="success" />
      </ExePackage>

      <!--
        The existing MSI, unchanged. DisplayInternalUICondition shows the
        MSI's own CertusUi.wxs wizard on first install of the bundle
        (WixBundleInstalled = 0, which also covers an upgrade launched by
        double clicking a newer bundle); repair, modify, and uninstall of the
        installed bundle run the MSI quietly under Burn's own progress UI.
        WixBundleInstalled is used instead of the numeric WixBundleAction
        enum, whose values shifted between WiX v3 and v4.
        ARPSYSTEMCOMPONENT=1 hides the MSI's Apps and Features row only when
        installed through the bundle. Permanent defaults to no, so
        uninstalling the bundle removes the MSI.
      -->
      <MsiPackage Id="DucksInARowMsi"
                  SourceFile="$(var.MsiPath)"
                  Compressed="yes"
                  Vital="yes"
                  bal:DisplayInternalUICondition="WixBundleInstalled = 0">
        <MsiProperty Name="ARPSYSTEMCOMPONENT" Value="1" />
        <!-- The MSI's public properties, from the variables declared below. -->
        <MsiProperty Name="INSTALLFOLDER" Value="[INSTALLFOLDER]" />
        <MsiProperty Name="DATAFOLDER" Value="[DATAFOLDER]" />
        <MsiProperty Name="START_SERVICE" Value="[START_SERVICE]" />
        <MsiProperty Name="MONITOR_ONLY" Value="[MONITOR_ONLY]" />
        <MsiProperty Name="ALLOW_INCOMPATIBLE_MODULE" Value="[ALLOW_INCOMPATIBLE_MODULE]" />
      </MsiPackage>
    </Chain>

    <!--
      The MSI's public properties, settable on the setup exe's command line
      (issue #471), for example:
        Ducks-in-a-Row-Setup.exe /quiet MONITOR_ONLY=1
      Before this the bundle declared no variables and passed nothing, although
      the docs said it accepted the MSI's switches. WixStdBA takes NAME=value
      from its command line only for an overridable variable, and names are
      upper cased, so these match however they are typed.

      Every property is passed on every run. One that was not given formats to
      an empty value, and an empty property on the msiexec command line is the
      same as one never set, so the MSI's own defaults, its remembered folders
      and its remembered mode all still apply. The one exception is
      START_SERVICE, whose MSI default is 1: an empty value would unset it and
      the service would not start, so its variable carries that default here
      too. Passing everything unconditionally keeps the result independent of
      how Burn would judge a bare "0" in a condition.

      ALLOW_INCOMPATIBLE_MODULE (issue #495) is the fifth, with no default:
      the go ahead for an upgrade that leaves an installed paid module unable
      to load. The MSI's wizard asks instead when it is shown (a first run of
      the setup exe, an upgrade included). /quiet and /passive run the MSI
      without that page, so either one refuses such an upgrade unless this is
      given:
        Ducks-in-a-Row-Setup.exe /quiet ALLOW_INCOMPATIBLE_MODULE=1
    -->
    <Variable Name="INSTALLFOLDER" bal:Overridable="yes" />
    <Variable Name="DATAFOLDER" bal:Overridable="yes" />
    <Variable Name="START_SERVICE" Value="1" bal:Overridable="yes" />
    <Variable Name="MONITOR_ONLY" bal:Overridable="yes" />
    <Variable Name="ALLOW_INCOMPATIBLE_MODULE" bal:Overridable="yes" />
  </Bundle>
</Wix>
